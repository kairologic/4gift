---
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { SITE } from '../site';

// Posts to the contact API (infra/lib/contact-stack.ts), which emails the store's inbox.
const endpoint = import.meta.env.PUBLIC_CONTACT_URL ?? '';
const topics = ['question', 'gift suggestion', 'correction', 'partnership', 'other'];
---
<Base title="Contact us" description={`Questions, gift suggestions and corrections for ${SITE.name}.`}>
  <div class="wrap read prose" style="padding-bottom:48px">
    <Breadcrumbs items={[{ name: 'Contact' }]} />
    <h1>Contact us</h1>
    <p>A gift idea we should add, a list you'd like to see, a broken link or a question: send it here and a person reads it. See our <a href="/privacy/">privacy policy</a> for what happens to your message. We answer most messages within a few days.</p>
    <p>We don't sell anything directly, so for orders, delivery or returns, contact the retailer you bought from.</p>
    {endpoint ? (
      <form id="contact" class="contact-form card" data-endpoint={endpoint}>
        <label>Your name <input name="name" required maxlength="100" autocomplete="name" /></label>
        <label>Email <input name="email" type="email" required maxlength="200" autocomplete="email" /></label>
        <label>About
          <select name="topic">{topics.map((t) => <option value={t}>{t[0].toUpperCase() + t.slice(1)}</option>)}</select>
        </label>
        <label>Message <textarea name="message" required minlength="10" maxlength="5000" rows="7"></textarea></label>
        <label class="hp" aria-hidden="true">Website <input name="website" tabindex="-1" autocomplete="off" /></label>
        <button class="btn secondary" type="submit">Send</button>
        <p class="form-status" role="status" aria-live="polite"></p>
      </form>
    ) : (
      <p>The contact form isn't connected yet.</p>
    )}
  </div>
</Base>

<script>
  const form = document.getElementById('contact') as HTMLFormElement | null;
  if (form) {
    const started = Date.now();
    const status = form.querySelector('.form-status') as HTMLElement;
    const button = form.querySelector('button') as HTMLButtonElement;
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      button.disabled = true;
      status.textContent = 'Sending…';
      const data = Object.fromEntries(new FormData(form));
      try {
        const r = await fetch(form.dataset.endpoint!, {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ ...data, t: started, page: document.referrer }),
        });
        const body = await r.json().catch(() => ({}));
        if (!r.ok) throw new Error(body.error || 'Something went wrong. Please try again.');
        form.reset();
        status.textContent = 'Thanks, your message is on its way. We will reply by email.';
      } catch (err) {
        status.textContent = (err as Error).message;
      } finally {
        button.disabled = false;
      }
    });
  }
</script>
