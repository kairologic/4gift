---
import SaveButton from './SaveButton.astro';
import { buyUrl, listsOf, pickUrl, picksFor, priceLabel, type Gift } from '../lib/gifts';
import { allPins, giftPinName, pinPath } from '../lib/pins';
import { ART_H, ART_W, giftArtPath, giftArtSlugs } from '../lib/gift-art';
interface Props { gift: Gift; rank: number; except?: string; page: string; showRank?: boolean }
const { gift, rank, except, page, showRank = true } = Astro.props;
const pin = allPins().find((p) => p.name === giftPinName(gift))!;
// data-* drive the list page's budget filter and sort without a round trip.
const lists = listsOf(gift).filter((l) => !except || !l.href.endsWith(`/${except}/`)).slice(0, 4);
// Named products first; the search button stays for readers who want to browse the whole gift idea.
const named = picksFor(gift).slice(0, 4);
const hasArt = giftArtSlugs().includes(gift.slug);
---
<article class="gift-card" id={gift.slug} data-from={gift.from} data-to={gift.to} data-tags={gift.tags.join(' ')} data-rank={rank}>
  {hasArt && <img class="gift-art" src={giftArtPath(gift.slug)} alt="" width={ART_W} height={ART_H} loading="lazy" decoding="async" />}
  {showRank && <span class="rank">No. {rank}</span>}
  <h3>{gift.name}</h3>
  <p class="price">{priceLabel(gift)} <small class="meta">typical price</small></p>
  <p class="why">{gift.why}</p>
  {named.length > 0 && (
    <div class="picks">
      <p class="picks-label">Our picks</p>
      <ul>
        {named.map((p) => (
          <li>
            <a href={pickUrl(p)} rel="sponsored noopener" target="_blank" data-gift={gift.slug} data-asin={p.asin}><strong>{p.name}</strong></a>
            <span class="meta"> by {p.brand}.</span> {p.note}
          </li>
        ))}
      </ul>
    </div>
  )}
  <div class="actions">
    <a class="btn" href={buyUrl(gift)} rel="sponsored noopener" target="_blank">{named.length ? 'See more on Amazon' : 'Shop on Amazon'}</a>
    <SaveButton url={`${page}#${gift.slug}`} image={pinPath(pin.name)} description={pin.description} />
  </div>
  {lists.length > 0 && <div class="tags">{lists.map((l) => <a class="chip" href={l.href}>{l.name}</a>)}</div>}
</article>
