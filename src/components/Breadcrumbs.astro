---
// Breadcrumb trail plus its BreadcrumbList schema. The last item is the current page and is not linked.
interface Props { items: { name: string; href?: string }[] }
const { items } = Astro.props;
const trail = [{ name: 'Home', href: '/' }, ...items];
const schema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: trail.map((c, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: c.name,
    ...(c.href ? { item: new URL(c.href, Astro.site).toString() } : {}),
  })),
};
---
<nav class="crumbs" aria-label="Breadcrumb">
  {trail.map((c, i) => (
    <>
      {i > 0 && <span aria-hidden="true"> › </span>}
      {c.href && i < trail.length - 1 ? <a href={c.href}>{c.name}</a> : <span aria-current="page">{c.name}</span>}
    </>
  ))}
</nav>
<script type="application/ld+json" set:html={JSON.stringify(schema)} />
