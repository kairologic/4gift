---
// "Save to Pinterest" as a plain link to Pinterest's pin builder: no Pinterest script on our pages, no cookies.
interface Props { url: string; image: string; description: string; label?: string }
const { url, image, description, label = 'Save' } = Astro.props;
const href = new URL('https://www.pinterest.com/pin/create/button/');
href.searchParams.set('url', new URL(url, Astro.site).toString());
href.searchParams.set('media', new URL(image, Astro.site).toString());
href.searchParams.set('description', description.slice(0, 500));
---
<a class="pin-save" href={href.toString()} target="_blank" rel="noopener" aria-label={`${label} to Pinterest`}>
  <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path fill="currentColor" d="M12 21.4l-1.5-1.3C5.4 15.4 2 12.3 2 8.5 2 5.4 4.4 3 7.5 3c1.7 0 3.4.8 4.5 2.1C13.1 3.8 14.8 3 16.5 3 19.6 3 22 5.4 22 8.5c0 3.8-3.4 6.9-8.5 11.6L12 21.4z"/></svg>
  {label}<span class="pin-long">to Pinterest</span>
</a>
